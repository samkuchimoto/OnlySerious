rules_version = '2';

// Collections match lib/types.ts. Client writes are restricted wherever a
// field's real value depends on server-side moderation or business logic
// (lib/moderation.ts, match-making, subscription state) — those fields
// only ever change through an app/api/** route using firebase-admin,
// which bypasses these rules entirely. A client can never write itself
// into "active" status, mark its own photo "approved", or send a message
// with flagged=false to dodge moderation.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Fields a user can never set/change on their own profile — these are
    // only ever written by a server route via the Admin SDK.
    function touchesServerOnlyFields() {
      let lockedFields = [
        'status', 'subscriptionStatus', 'stripeCustomerId', 'stripeSubscriptionId',
        'photos', 'dailyLikesUsed', 'dailyLikesDate', 'selfieVerified', 'lastMessageAt'
      ];
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(lockedFields);
    }

    match /users/{userId} {
      // Signed-in only, now that browse is real — an active profile isn't
      // meant to be scraped by anyone without an account.
      allow read: if isOwner(userId) || (isSignedIn() && resource.data.status == 'active');

      allow create: if isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.status == 'pending_review'
        && request.resource.data.subscriptionStatus == 'free'
        && request.resource.data.photos.size() == 0;

      allow update: if isOwner(userId) && !touchesServerOnlyFields();

      allow delete: if isOwner(userId);

      // Full moderation history (including pending/rejected) for the
      // owner's own eyes only — written exclusively by app/api/photos via
      // the Admin SDK, right after a real moderatePhoto() call.
      match /photoSubmissions/{photoId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Private per-viewer notes about other profiles (ThaiFriendly's
      // "your private notes for {name}" pattern) — keyed by the *viewed*
      // profile's id under the *viewer's* own user doc, so this is
      // naturally owner-only and never visible to the person the note is
      // about.
      match /notes/{aboutUserId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /matches/{matchId} {
      // Match creation requires evaluating mutual intent server-side —
      // never a direct client write.
      allow read: if isSignedIn() && request.auth.uid in resource.data.userIds;
      allow write: if false;
    }

    match /messages/{messageId} {
      allow read: if isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(resource.data.matchId)).data.userIds;
      // Sending goes through a server route so `flagged` reflects a real
      // moderateText() call, not a client-asserted value.
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reportedByUserId == request.auth.uid
        && request.resource.data.reportedUserId != request.auth.uid
        && request.resource.data.status == 'open';
      // The review queue is server/admin-only — no client reads.
      allow read, update, delete: if false;
    }

    match /likes/{likeId} {
      // Writes stay server-only (the daily-limit check, deterministic-id
      // idempotency, and mutual-match detection all have to be trusted —
      // a client could otherwise skip its own limit or double-like).
      // Only "who have I already liked" is readable from the client —
      // Browse needs it to stop re-showing a profile you've liked.
      //
      // "Who liked me" is deliberately NOT readable here. It's the paid
      // feature (app/api/liked-me), and leaving this open would have made
      // that paywall decoration: anyone could run the same query from
      // devtools and read every liker's identity. The server route uses
      // the Admin SDK, which bypasses these rules.
      allow read: if isSignedIn() && resource.data.likerId == request.auth.uid;
      allow write: if false;
    }

    match /waitlist/{entryId} {
      // Prelaunch email capture (homepage + the sign-up gate shown to men
      // while registration is women-first) — most visitors here aren't
      // signed in, so validation lives entirely in this rule rather than
      // trusting a server route: exactly these two fields, a real-looking
      // email, a real client timestamp. No read access is granted (or
      // needed) since nothing client-side ever displays this list back;
      // duplicate emails are a non-issue for a list that just gets
      // emailed once at launch.
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
        && request.resource.data.createdAt is string;
      allow read, update, delete: if false;
    }

    match /blocks/{blockId} {
      // Deterministic id ({blockerId}_{blockedId}) makes a duplicate
      // block a no-op overwrite rather than a second document. Readable
      // by either side, since both a blocker (to filter their own
      // browse) and the blocked person (so they're excluded from
      // showing up to the blocker too) need to know it exists.
      allow read: if isSignedIn()
        && (resource.data.blockerId == request.auth.uid || resource.data.blockedId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId != request.auth.uid
        && blockId == request.resource.data.blockerId + '_' + request.resource.data.blockedId;
      allow delete: if isSignedIn() && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    match /hides/{hideId} {
      // Lighter-weight than blocks/{blockId} above — same deterministic-
      // id shape, but reads are hider-only (the hidden person never sees
      // this, unlike a block which both sides can see).
      allow read: if isSignedIn() && resource.data.hiderId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.hiderId == request.auth.uid
        && request.resource.data.hiddenId != request.auth.uid
        && hideId == request.resource.data.hiderId + '_' + request.resource.data.hiddenId;
      allow delete: if isSignedIn() && resource.data.hiderId == request.auth.uid;
      allow update: if false;
    }
  }
}
