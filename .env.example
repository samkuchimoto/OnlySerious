# Client-exposed Firebase config — create a NEW, separate Firebase
# project for this app (console.firebase.google.com > Add project). Not
# connected to any other project's Firebase in any way.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin service account — Project Settings > Service
# Accounts > Generate new private key, in that same new Firebase project.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Groq — real photo moderation (lib/moderation.ts), a vision-capable
# model as a classifier. Free tier, no Cloud Billing account needed
# (unlike Google Cloud Vision, which requires one even to stay within its
# free quota). Get a key at console.groq.com/keys. Missing key means
# photos go to manual review instead of being silently approved — see
# lib/moderation.ts's own reasoning.
GROQ_API_KEY=

# Vercel Blob — photo storage (app/api/photos/route.ts). Auto-provisioned:
# create a Blob store from the Vercel dashboard (your project > Storage >
# Create Database > Blob) and it injects BLOB_READ_WRITE_TOKEN into your
# project's env vars automatically — nothing to paste here by hand.
# See docs/setup-vercel-blob.md.
BLOB_READ_WRITE_TOKEN=

# Stripe — subscription billing, once pricing model is decided. Same
# pattern as any Stripe integration: Secret key + webhook signing secret,
# a real recurring Price created in the Stripe Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

NEXT_PUBLIC_APP_URL=
