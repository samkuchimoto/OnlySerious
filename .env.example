# Client-exposed Firebase config — create a NEW, separate Firebase
# project for this app (console.firebase.google.com > Add project). Not
# connected to any other project's Firebase in any way.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin service account — Project Settings > Service
# Accounts > Generate new private key, in that same new Firebase project.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Google Cloud Vision — real photo moderation (lib/moderation.ts). Enable
# the Vision API at console.cloud.google.com/apis/library/vision.googleapis.com
# on a NEW Google Cloud project (can be linked to the same Firebase
# project, since Firebase projects ARE Google Cloud projects), then
# Credentials > Create Credentials > API key. Free tier covers the first
# 1,000 units/month. Missing key means photos go to manual review instead
# of being silently approved — see lib/moderation.ts's own reasoning.
GOOGLE_CLOUD_VISION_API_KEY=

# Stripe — subscription billing, once pricing model is decided. Same
# pattern as any Stripe integration: Secret key + webhook signing secret,
# a real recurring Price created in the Stripe Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

NEXT_PUBLIC_APP_URL=
