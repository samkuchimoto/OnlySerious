# Client-exposed Firebase config — create a NEW, separate Firebase
# project for this app (console.firebase.google.com > Add project). Not
# connected to any other project's Firebase in any way.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin service account — Project Settings > Service
# Accounts > Generate new private key, in that same new Firebase project.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Groq — real photo moderation (lib/moderation.ts), a vision-capable
# model as a classifier. Free tier, no Cloud Billing account needed. Get
# a key at console.groq.com/keys. Required (not just an upgrade) — it's
# the only one of the two moderation vendors that can judge "is this
# AI-generated", which Google Cloud Vision has no equivalent for. Missing
# key means photos go to manual review instead of being silently
# approved — see lib/moderation.ts's own reasoning.
GROQ_API_KEY=

# Google Cloud Vision — optional stricter second opinion on racy/explicit
# content specifically, layered on top of Groq's own judgment (not a
# replacement for it — see lib/moderation.ts's file header). Requires a
# Cloud Billing account even for light usage, unlike Groq, so this is
# meant to be added once Blaze billing is already active for another
# reason (e.g. phone verification), not on its own. See
# docs/setup-google-vision.md.
GOOGLE_CLOUD_VISION_API_KEY=

# Vercel Blob — photo storage (app/api/photos/route.ts). Auto-provisioned:
# create a Blob store from the Vercel dashboard (your project > Storage >
# Create Database > Blob) and it injects BLOB_READ_WRITE_TOKEN into your
# project's env vars automatically — nothing to paste here by hand.
# See docs/setup-vercel-blob.md.
BLOB_READ_WRITE_TOKEN=

# Firebase Cloud Messaging — push notifications for likes/matches/
# messages (lib/messaging.ts). Free, no billing account needed. Get the
# key at Firebase Console > Project Settings > Cloud Messaging > Web
# Push certificates > Generate key pair. See docs/setup-push-notifications.md.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Stripe — subscription billing (app/api/stripe/**). All three are
# required together: with any of them missing the billing routes return
# 503 and the UI says subscriptions aren't switched on yet, rather than
# throwing at the conversion moment. STRIPE_PRICE_ID is the *price* id
# (price_...) of a recurring monthly Price, not the product id.
# The webhook is the only thing that ever grants paid access — see
# docs/setup-stripe.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

NEXT_PUBLIC_APP_URL=

# PostHog — funnel/event tracking (lib/analytics.ts, instrumentation-client.ts).
# Optional: with no key set, every capture() is a silent no-op and the app
# behaves exactly as before. Free tier is ~1M events/month. Get the key at
# Project Settings > Project API Key. NEXT_PUBLIC_POSTHOG_HOST must match
# the region you signed up in — EU and US are separate deployments and a
# key from one is rejected by the other. See docs/setup-posthog.md.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Android / Play Store (Trusted Web Activity) — only needed once the app
# is built with Bubblewrap. Serves /.well-known/assetlinks.json, which is
# what lets Android verify the app owns this domain and drop the URL bar.
# ANDROID_CERT_FINGERPRINTS is comma-separated and must eventually list
# TWO values: your local upload key, and the key Google Play App Signing
# re-signs with (Play Console > Release > Setup > App signing). Missing
# the second one ships the app with Chrome's address bar visible to every
# real user. See docs/setup-android-app.md.
ANDROID_PACKAGE_NAME=app.osthai.twa
ANDROID_CERT_FINGERPRINTS=

# Android distribution — both optional and both hidden from /get-app
# until set, so the page never advertises a channel that doesn't exist.
# NEXT_PUBLIC_PLAY_STORE_URL is the listing URL once published.
# NEXT_PUBLIC_APK_URL is a direct .apk download for people who install
# outside Google Play (a real audience in Southeast Asia) and for
# testers before the listing is live.
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APK_URL=
