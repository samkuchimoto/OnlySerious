# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# raw image downloads dropped in the repo root for reference — the
# actual asset lives under public/images/ once it's in use
/ChatGPT Image*.png
/Gemini_Generated_Image*

# Android / TWA build output. The generated project is reproducible from
# twa-manifest.json, so only that is committed.
/android/

# Signing keystore — NEVER commit. Anyone holding it can publish an
# update that Google Play will accept as genuinely yours, and losing it
# means the listing can never be updated again. Keep the backup outside
# this repo.
*.keystore
*.jks
